    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="200" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Border Grid.ColumnSpan="2" Background="#180303" BorderBrush="#343434" BorderThickness="0,0,0,1">
