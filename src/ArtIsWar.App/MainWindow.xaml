                      <WrapPanel>
                        <Button Content="Restore original audio" Command="{Binding RestoreCommand}" />
                        <Button Content="Remove audio configuration" Command="{Binding RemoveCommand}" Style="{StaticResource QuietButton}" BorderBrush="#674047" />
                      </WrapPanel>
                    </StackPanel>
                  </Border>
                </TabItem>
                <TabItem Header="Repair">
                  <StackPanel>
                    <TextBlock Text="System Repair" Foreground="#FFD600" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <TextBlock Text="Diagnose and fix your existing audio configuration. Repair and restart can interrupt playback." Foreground="#999999" Margin="0,0,0,20" />
                    <Grid Height="470">
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                      </Grid.RowDefinitions>
                      <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                          <Button Content="Run diagnostics" Command="{Binding DiagnosticsCommand}" Style="{StaticResource Primary}" />
                          <Button Content="Export report" Command="{Binding ExportCommand}" Style="{StaticResource QuietButton}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                          <Button Content="Repair setup" Command="{Binding RepairCommand}" Style="{StaticResource QuietButton}" />
                          <Button Content="Restart audio" Command="{Binding RestartCommand}" Style="{StaticResource QuietButton}" Margin="0,0,0,8" />
                        </StackPanel>
                      </Grid>
                      <Border Grid.Row="1" Style="{StaticResource Card}" Padding="12">
                        <StackPanel>
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition />
                              <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding ApoStatus}" />
                            <TextBlock Grid.Column="1" Text="{Binding DspStatus}" Foreground="{Binding DspStatus, Converter={StaticResource StatusBrush}}" />
                          </Grid>
                          <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding DiagnosticRows}" Margin="0,8,0,0">
