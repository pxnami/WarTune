          <TextBlock Text="WarTune" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" Foreground="#A72D2D" />
          <TextBlock Text="WARZONE AUDIO" FontSize="9" FontFamily="Consolas" Foreground="#8C939E" Margin="8,0,0,0" VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" shell:WindowChrome.IsHitTestVisibleInChrome="True">
          <TextBlock Text="{Binding DspStatus}" FontSize="10" Foreground="{Binding DspStatus, Converter={StaticResource StatusBrush}}" VerticalAlignment="Center" Margin="0,0,14,0" />
          <TextBlock Text="1.0.0" FontFamily="Consolas" FontSize="10" Foreground="#777F8B" VerticalAlignment="Center" Margin="0,0,20,0" />
          <Button Style="{StaticResource WindowButton}" Click="Minimize_Click" ToolTip="Minimize">
