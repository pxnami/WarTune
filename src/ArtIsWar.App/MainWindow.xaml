                    <TextBlock Text="Warzone / Black Ops 7" FontWeight="SemiBold" Foreground="#FFD600" Margin="0,0,0,14" />
                    <TextBlock Text="Current headphone" Style="{StaticResource Hint}" />
                    <TextBox Text="{Binding Headphones, UpdateSourceTrigger=PropertyChanged}" Margin="0,8,0,12" />
                    <Button Content="Save headphone profile" Command="{Binding SaveHeadphonesCommand}" />
                  </StackPanel>
                </Border>
                <Border BorderBrush="#343434" BorderThickness="1" CornerRadius="10" Padding="20">
                  <StackPanel>
                    <TextBlock Text="Headphone correction" FontWeight="SemiBold" />
                    <TextBlock Text="1. Name your headphones&#xA;2. Import your AutoEQ PEQ&#xA;3. Apply the correction" Style="{StaticResource Hint}" Margin="0,14" />
                    <Button Content="Edit correction filters" Tag="4" Click="Navigate_Click" />
                  </StackPanel>
                </Border>
                <TextBlock Text="Saved headphone profiles and imported PEQ are local to this PC. No online measurement database is connected." Style="{StaticResource Hint}" Margin="14,22" />
              </StackPanel>
            </ScrollViewer>
            <Border Grid.Column="2" Background="#242424" CornerRadius="10" Padding="16">
              <DockPanel>
                <WrapPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                  <Button Content="+ Import AutoEQ PEQ" Command="{Binding ImportCommand}" />
                  <Button Content="Load selected" Command="{Binding LoadHeadphoneCommand}" Style="{StaticResource Primary}" />
                </WrapPanel>
                <StackPanel DockPanel.Dock="Top">
                  <TextBlock Text="MEASUREMENT / LOCAL PROFILES" Style="{StaticResource Label}" />
                  <TextBlock Text="Search for your headphones" Foreground="#FFD600" FontWeight="SemiBold" Margin="0,0,0,8" />
                  <TextBox Text="{Binding HeadphoneSearch, UpdateSourceTrigger=PropertyChanged}" Padding="14,12" BorderBrush="#FFD600" Style="{StaticResource SearchBox}" ToolTip="Search headphones..." Height="48" />
                  <TextBlock Text="Ready To Use — Local" Foreground="#FFD600" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding HeadphoneLibrary.Count, StringFormat={}{0} saved profiles}" Style="{StaticResource Hint}" Margin="0,4,0,14" />
                  <Border Height="1" Background="#3A3A3A" Margin="0,0,0,8" />
                </StackPanel>
                <ListBox ItemsSource="{Binding HeadphoneLibrary}" SelectedItem="{Binding SelectedHeadphone}">
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                          <TextBlock Text="{Binding Filters.Count, StringFormat={}{0} filters · local profile}" FontSize="10" Foreground="#999999" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="Select" Tag="{Binding}" Click="HeadphoneSelect_Click" Style="{StaticResource Primary}" Margin="8,0,0,0" Padding="10,3" />
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </DockPanel>
            </Border>
          </Grid>
        </TabItem>
        <TabItem xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:ArtIsWar.App.Controls">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,8,0">
              <Border Style="{StaticResource Card}" Padding="12">
                <StackPanel>
                  <DockPanel>
                    <TextBlock Text="FREQUENCY RESPONSE" Style="{StaticResource Label}" />
                    <TextBlock Text="48 kHz / FILTER PREVIEW" FontFamily="Consolas" FontSize="10" Foreground="#BFA08C" HorizontalAlignment="Right" />
                  </DockPanel>
                  <controls:ResponseGraph Filters="{Binding ResponseFilters}" Height="205" />
                </StackPanel>
              </Border>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="18" />
                  <ColumnDefinition Width="250" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}" Padding="12">
                  <StackPanel>
                    <ComboBox ItemsSource="{Binding FilterTargets}" SelectedItem="{Binding FilterTarget}" />
                    <Grid Margin="12,8,12,10">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="45" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="75" />
                        <ColumnDefinition Width="42" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="TYPE" Style="{StaticResource Label}" />
                      <TextBlock Grid.Column="1" Text="FREQUENCY" Style="{StaticResource Label}" />
                      <TextBlock Grid.Column="2" Text="GAIN" Style="{StaticResource Label}" />
                      <TextBlock Grid.Column="3" Text="Q" Style="{StaticResource Label}" />
                    </Grid>
                    <ListBox ItemsSource="{Binding Filters}" SelectedItem="{Binding SelectedFilter}" Height="220">
                      <ListBox.ItemTemplate>
                        <DataTemplate>
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="45" />
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="75" />
                              <ColumnDefinition Width="42" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Type}" FontFamily="Consolas" />
                            <TextBlock Grid.Column="1" Text="{Binding Frequency, StringFormat={}{0:g} Hz}" FontFamily="Consolas" />
                            <TextBlock Grid.Column="2" Text="{Binding Gain, StringFormat={}{0:+0.0;-0.0;0} dB}" FontFamily="Consolas" />
                            <TextBlock Grid.Column="3" Text="{Binding Q, StringFormat={}{0:0.##}}" FontFamily="Consolas" />
                            <Grid.Style>
                              <Style TargetType="Grid">
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding Enabled}" Value="False">
                                    <Setter Property="Opacity" Value=".4" />
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </Grid.Style>
                          </Grid>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                    <Button Content="Create 10-band beginner EQ" Command="{Binding GraphicCommand}" Style="{StaticResource QuietButton}" Margin="0,18,0,0" HorizontalAlignment="Left" />
                    <TextBlock Text="Creates editable bands from 31 Hz to 16 kHz. Replaces the advanced EQ draft." Style="{StaticResource Hint}" FontSize="10" Margin="0,12,0,0" />
                  </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="20">
                  <StackPanel>
                    <TextBlock Text="FILTER EDITOR" Style="{StaticResource Label}" />
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition />
                      </Grid.ColumnDefinitions>
                      <StackPanel>
                        <TextBlock Text="Type" Style="{StaticResource Hint}" Margin="0,0,0,7" />
                        <ComboBox ItemsSource="{Binding FilterTypes}" SelectedItem="{Binding FilterTypeName}" ToolTip="PK: peaking; LSC/HSC: shelf; HPQ/LPQ: pass filter." />
                      </StackPanel>
                      <StackPanel Grid.Column="2">
                        <TextBlock Text="Q" Style="{StaticResource Hint}" Margin="0,0,0,7" />
                        <TextBox Text="{Binding FilterQ}" />
                      </StackPanel>
                    </Grid>
                    <TextBlock Text="Frequency / Hz" Style="{StaticResource Hint}" Margin="0,0,0,7" />
                    <TextBox Text="{Binding FilterFrequency}" />
                    <TextBlock Text="Gain / dB" Style="{StaticResource Hint}" Margin="0,0,0,7" />
                    <TextBox Text="{Binding FilterGain}" />
                    <CheckBox Content="Filter enabled" IsChecked="{Binding FilterEnabled}" />
                    <Button Content="Update selected" Command="{Binding UpdateFilterCommand}" Margin="0,0,0,8" />
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition />
                      </Grid.ColumnDefinitions>
                      <Button Content="Add" Command="{Binding AddFilterCommand}" Style="{StaticResource QuietButton}" Margin="0" />
                      <Button Grid.Column="2" Content="Delete" Command="{Binding DeleteFilterCommand}" Style="{StaticResource QuietButton}" Margin="0" />
                    </Grid>
                    <Border Style="{StaticResource Divider}" />
                    <Button Content="Apply EQ" Command="{Binding ApplyCommand}" Style="{StaticResource Primary}" Margin="0" />
                  </StackPanel>
                </Border>
              </Grid>
              <TextBlock Text="Combined headphone, Warzone and advanced EQ preview. Preamp and dynamic gain are not shown. Applied frequencies use 1 Hz resolution." Style="{StaticResource Hint}" FontSize="10" />
            </StackPanel>
          </ScrollViewer>
        </TabItem>
        <TabItem xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:ArtIsWar.App.Controls">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="90" />
              <RowDefinition Height="*" />
              <RowDefinition Height="100" />
            </Grid.RowDefinitions>
            <Border Background="#242424" Padding="20,12">
              <ItemsControl ItemsSource="{Binding ReferenceSetupStages}" Margin="0" Width="540" HorizontalAlignment="Center">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <UniformGrid Columns="4" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid>
                      <Border Width="40" Height="2" Background="#444444" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,19,-18,0">
                        <Border.Style>
                          <Style TargetType="Border">
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding Name}" Value="Complete">
                                <Setter Property="Visibility" Value="Collapsed" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </Border.Style>
                      </Border>
                      <StackPanel Margin="3,0">
                        <Border CornerRadius="22" Padding="0,8" Width="38" Height="38">
                          <TextBlock Text="{Binding Number}" HorizontalAlignment="Center" FontWeight="SemiBold" FontSize="18" Foreground="#171717" />
                          <Border.Style>
                            <Style TargetType="Border">
                              <Setter Property="Background" Value="{Binding Color}" />
                              <Setter Property="BorderBrush" Value="{Binding Color}" />
                              <Setter Property="BorderThickness" Value="2" />
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding Color}" Value="#3A3A3A">
                                  <Setter Property="Background" Value="Transparent" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </Border.Style>
                        </Border>
                        <TextBlock Text="{Binding Name}" FontSize="10" Foreground="#9D9D9D" TextAlignment="Center" Margin="0,5,0,0" />
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Border>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
              <StackPanel MaxWidth="640" Margin="0,60,8,24">
                <Border Style="{StaticResource Card}" Padding="30">
                  <StackPanel>
                    <TextBlock Text="SETUP ASSISTANT" Style="{StaticResource Label}" />
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="{Binding SetupTitle}" Style="{StaticResource SectionHeading}" FontSize="24" Margin="0,0,18,0" Foreground="#FFD600" />
                      <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="Back" Command="{Binding BackCommand}" Style="{StaticResource QuietButton}" />
                        <Button Content="Continue" Command="{Binding NextCommand}" Style="{StaticResource Primary}" Margin="0" />
                      </StackPanel>
                    </Grid>
                    <TextBlock Text="{Binding SetupDescription}" Style="{StaticResource Hint}" Margin="0,8,0,19" />
                    <ProgressBar Value="{Binding SetupProgress, Mode=OneWay}" Maximum="100" />
                  </StackPanel>
                </Border>
                <Expander Header="Devices, software and audio test" Foreground="#AAAAAA" IsExpanded="{Binding SetupDetailsExpanded, Mode=OneWay}" Margin="0,12,0,0">
                  <StackPanel Margin="0,12,0,0">
                    <Border Style="{StaticResource Card}">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="22" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                          <TextBlock Text="PLAYBACK OUTPUT" Style="{StaticResource Label}" />
                          <ComboBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}" />
                          <TextBlock Text="{Binding SupportedRates}" Style="{StaticResource Hint}" />
                          <TextBlock Text="{Binding DefaultOutput, StringFormat=Windows default: {0}}" Style="{StaticResource Hint}" FontSize="10" Margin="0,8,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                          <TextBlock Text="HEADPHONE MODEL" Style="{StaticResource Label}" />
                          <TextBox Text="{Binding Headphones, UpdateSourceTrigger=PropertyChanged}" />
                          <TextBlock Text="Endpoint names may not identify your headphones. Enter the model manually." Style="{StaticResource Hint}" FontSize="11" />
                        </StackPanel>
                      </Grid>
                    </Border>
                    <Border Style="{StaticResource Card}">
                      <StackPanel>
                        <TextBlock Text="SYSTEM SNAPSHOT" Style="{StaticResource Label}" />
                        <TextBlock Text="{Binding HardwareSummary}" FontSize="12" LineHeight="20" />
                        <Border Style="{StaticResource Divider}" />
                        <WrapPanel>
                          <Button Content="APO Device Selector" Command="{Binding ConfiguratorCommand}" />
                          <Button Content="Windows Sound" Command="{Binding SoundSettingsCommand}" Style="{StaticResource QuietButton}" />
                          <Button Content="Run as administrator" Command="{Binding AdminCommand}" Style="{StaticResource QuietButton}" />
                          <Button Content="Equalizer APO website" Command="{Binding InstallCommand}" Style="{StaticResource QuietButton}" />
                        </WrapPanel>
                      </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                      <StackPanel>
                        <TextBlock Text="LISTENING TEST" Style="{StaticResource Label}" />
                        <TextBlock Text="Check your output before playing." Style="{StaticResource SectionHeading}" />
                        <TextBlock Text="Use low volume. These are synthetic test sounds, not game recordings." Style="{StaticResource Hint}" Margin="0,0,0,18" />
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <ComboBox ItemsSource="{Binding TestKinds}" SelectedItem="{Binding TestKind}" Margin="0" />
                          <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <Button Content="Play test" Command="{Binding TestCommand}" Style="{StaticResource Primary}" />
                            <Button Content="Stop" Command="{Binding StopTestCommand}" Style="{StaticResource QuietButton}" Margin="0" />
                          </StackPanel>
                        </Grid>
                        <Button Content="Apply / enable processing" Command="{Binding ApplyCommand}" Style="{StaticResource QuietButton}" Margin="0,15,0,0" HorizontalAlignment="Left" />
                      </StackPanel>
                    </Border>
                  </StackPanel>
                </Expander>
              </StackPanel>
            </ScrollViewer>
            <Border Background="#111111" CornerRadius="10" Padding="14" Margin="0,8,0,0" Grid.Row="2">
              <StackPanel>
                <TextBlock Text="Console" Foreground="#777777" FontSize="12" Margin="0,0,0,8" />
                <TextBox Text="{Binding Message, Mode=OneWay}" IsReadOnly="True" Background="Black" FontFamily="Consolas" FontSize="12" BorderThickness="0" MinHeight="65" TextWrapping="Wrap" Margin="0" />
              </StackPanel>
            </Border>
          </Grid>
        </TabItem>
        <TabItem xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:ArtIsWar.App.Controls">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Margin="0,0,0,18">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Orientation="Horizontal">
                <Button Content="Run diagnostics" Command="{Binding DiagnosticsCommand}" Style="{StaticResource Primary}" />
                <Button Content="Export report" Command="{Binding ExportCommand}" Style="{StaticResource QuietButton}" />
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Repair setup" Command="{Binding RepairCommand}" Style="{StaticResource QuietButton}" />
                <Button Content="Restart audio" Command="{Binding RestartCommand}" Style="{StaticResource QuietButton}" Margin="0,0,0,8" />
              </StackPanel>
            </Grid>
            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="12">
              <StackPanel>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding ApoStatus}" />
                  <TextBlock Grid.Column="1" Text="{Binding DspStatus}" Foreground="{Binding DspStatus, Converter={StaticResource StatusBrush}}" />
                </Grid>
                <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto">
                  <ItemsControl ItemsSource="{Binding DiagnosticRows}" Margin="0,8,0,0">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Grid Margin="0,3">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" />
                          </Grid.ColumnDefinitions>
                          <TextBlock Text="{Binding Check}" Foreground="#969696" FontSize="11" />
                          <TextBlock Grid.Column="1" Text="{Binding Value}" FontFamily="Consolas" FontSize="11" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </StackPanel>
            </Border>
            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="12" Margin="0">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <DockPanel>
                  <TextBlock Text="DIAGNOSTIC CONSOLE" Style="{StaticResource Label}" />
                  <TextBlock Text="Export excludes personal paths and names" Style="{StaticResource Hint}" FontSize="10" HorizontalAlignment="Right" />
                </DockPanel>
                <TextBox Grid.Row="1" Text="{Binding Diagnostics, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="Transparent" BorderThickness="0" Padding="0,12,0,0" Margin="0" />
              </Grid>
            </Border>
          </Grid>
        </TabItem>
        <TabItem xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:ArtIsWar.App.Controls">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,8,0">
              <TabControl Style="{StaticResource CategoryTabs}" SelectedIndex="2">
                <TabItem Header="General">
                  <Border Style="{StaticResource Card}" CornerRadius="4" Padding="12" Background="Transparent">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="22" />
                        <ColumnDefinition Width="3*" />
                      </Grid.ColumnDefinitions>
                      <StackPanel>
                        <TextBlock Text="APPLICATION" Style="{StaticResource Label}" />
                        <TextBlock Text="Windows behavior" Style="{StaticResource SectionHeading}" />
                        <TextBlock Text="Keep the utility available when you need it." Style="{StaticResource Hint}" />
                      </StackPanel>
                      <StackPanel Grid.Column="2">
                        <CheckBox Content="Start WarTune with Windows" IsChecked="{Binding StartWithWindows}" />
                        <CheckBox Content="Close window to system tray" IsChecked="{Binding MinimizeToTray}" />
                        <Button Content="Open settings folder" Command="{Binding OpenDataCommand}" Style="{StaticResource QuietButton}" HorizontalAlignment="Left" Margin="0" />
                      </StackPanel>
                    </Grid>
                  </Border>
                </TabItem>
                <TabItem Header="Audio">
                  <Border Style="{StaticResource Card}" CornerRadius="4" Padding="12" Background="Transparent">
                    <StackPanel>
                      <TextBlock Text="AUDIO CONFIGURATION" Style="{StaticResource Label}" />
                      <TextBlock Text="Restore your original setup" Style="{StaticResource SectionHeading}" />
