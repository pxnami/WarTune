                                <DataTemplate>
                                  <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                      <ColumnDefinition Width="220" />
                                      <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Check}" Foreground="#969696" FontSize="11" />
                                    <TextBlock Grid.Column="1" Text="{Binding Value}" FontFamily="Consolas" FontSize="11" />
                                  </Grid>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                          </ScrollViewer>
                        </StackPanel>
                      </Border>
                      <Border Grid.Row="2" Style="{StaticResource Card}" Padding="12" Margin="0">
                        <Grid>
                          <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                          </Grid.RowDefinitions>
                          <DockPanel>
                            <TextBlock Text="DIAGNOSTIC CONSOLE" Style="{StaticResource Label}" />
                            <TextBlock Text="Export excludes personal paths and names" Style="{StaticResource Hint}" FontSize="10" HorizontalAlignment="Right" />
                          </DockPanel>
                          <TextBox Grid.Row="1" Text="{Binding Diagnostics, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="Transparent" BorderThickness="0" Padding="0,12,0,0" Margin="0" />
                        </Grid>
                      </Border>
                    </Grid>
                  </StackPanel>
                </TabItem>
                <TabItem Header="About">
                  <Border Style="{StaticResource Card}" Background="Transparent" CornerRadius="4" Padding="12">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <StackPanel>
                        <TextBlock Text="WarTune" FontSize="14" FontWeight="SemiBold" />
                        <TextBlock Text="Local processing. No account or telemetry." Style="{StaticResource Hint}" Margin="0,9,0,0" />
                        <TextBlock Text="Uninstall through Windows Apps after exiting the tray utility." Style="{StaticResource Hint}" FontSize="11" Margin="0,5,0,0" />
                      </StackPanel>
                      <TextBlock Grid.Column="1" Text="VERSION&#xA;1.0.0" FontFamily="Consolas" Foreground="#BFA08C" TextAlignment="Right" LineHeight="21" />
                    </Grid>
                  </Border>
                </TabItem>
              </TabControl>
            </StackPanel>
          </ScrollViewer>
        </TabItem>
      </TabControl>
    </Grid>
    <Border xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" Grid.Row="2" Grid.ColumnSpan="2" BorderBrush="#343434" BorderThickness="0,1,0,0" Padding="12,3">
      <Border.Style>
        <Style TargetType="Border">
          <Setter Property="Background" Value="#1B1B1B" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding MessageIsError}" Value="True">
              <Setter Property="Background" Value="#301E24" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </Border.Style>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="75" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="ACTIVITY" FontFamily="Consolas" FontSize="10" Foreground="#697382" VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" Text="{Binding Message}" Foreground="#ABB2BE" FontSize="11" />
      </Grid>
    </Border>
    <Border Grid.Row="3" Grid.ColumnSpan="2" Background="#242424" BorderBrush="{Binding DspStatus, Converter={StaticResource StatusBrush}}" BorderThickness="0,2,0,0" Padding="8,10" Name="StatusStrip">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="66" />
          <ColumnDefinition Width="3*" />
          <ColumnDefinition Width="124" />
          <ColumnDefinition Width="2*" />
          <ColumnDefinition Width="2*" />
        </Grid.ColumnDefinitions>
        <Border Background="#151515" BorderBrush="#343434" BorderThickness="1" CornerRadius="5" Padding="6">
          <StackPanel>
            <Button Content="⏻" Command="{Binding ToggleCommand}" FontSize="24" Margin="0,10" />
            <TextBlock Text="{Binding ToggleLabel}" FontSize="9" FontWeight="Bold" TextAlignment="Center" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
        <Border Grid.Column="1" Background="#141414" CornerRadius="5" Margin="8,0" Padding="10">
          <StackPanel>
            <TextBlock Text="PROFILE" Style="{StaticResource Label}" />
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="HEADPHONE" Style="{StaticResource Label}" Margin="0" />
                <TextBlock Text="{Binding Headphones}" FontWeight="SemiBold" FontSize="13" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Headphones}" />
                <TextBlock Text="{Binding ProfileSummary}" FontSize="12" Foreground="#999999" Margin="0,6,0,0" />
              </StackPanel>
              <StackPanel Grid.Column="1">
                <TextBlock Text="GAME" Style="{StaticResource Label}" Margin="0" />
                <TextBlock Text="Warzone" FontWeight="SemiBold" />
                <TextBlock Text="BO7" FontSize="12" Foreground="#FFD600" Margin="0,10,0,0" />
              </StackPanel>
            </Grid>
            <WrapPanel Margin="0,8,0,0">
              <Button Content="Go to Profiles" Click="Navigate_Click" Tag="2" FontSize="11" Padding="8,4" Margin="0,0,6,4" />
              <Button Content="+ Create Profile" Click="Navigate_Click" Tag="1" Style="{StaticResource Primary}" FontSize="11" Padding="8,4" Margin="0,0,6,4" />
            </WrapPanel>
          </StackPanel>
        </Border>
        <StackPanel Grid.Column="2">
          <TextBlock Text="TOOLS" Style="{StaticResource Label}" />
          <Button Content="EQ Control" Click="Navigate_Click" Tag="4" FontSize="11" Padding="6,4" Margin="0,0,6,4" />
          <Button Content="Sound Settings" Command="{Binding SoundSettingsCommand}" FontSize="11" Padding="6,4" Margin="0,0,6,4" />
          <Button Content="Diagnostics" Click="Navigate_Click" Tag="6" FontSize="11" Padding="6,4" Margin="0,0,6,4" />
          <Button Content="Restart Audio" Command="{Binding RestartCommand}" FontSize="11" Padding="6,4" Margin="0,0,6,4" />
        </StackPanel>
        <Border Grid.Column="3" Background="#141414" CornerRadius="5" Padding="10" Margin="4,0">
          <StackPanel>
            <TextBlock Text="HW OUTPUT" Style="{StaticResource Label}" />
            <TextBlock Text="{Binding OutputSummary}" FontWeight="SemiBold" FontSize="13" />
            <TextBlock Text="Selected playback endpoint" Style="{StaticResource Hint}" FontSize="10" Margin="0,8" />
            <Button Content="Switch output" Click="Navigate_Click" Tag="5" FontSize="11" Padding="8,4" Margin="0,0,6,4" />
          </StackPanel>
        </Border>
        <Border Grid.Column="4" Background="#141414" CornerRadius="5" Padding="10" Margin="4,0">
          <StackPanel>
            <TextBlock Text="PROCESSING" Style="{StaticResource Label}" />
            <TextBlock Text="WarTune" FontWeight="SemiBold" FontSize="16" />
            <TextBlock Text="{Binding ApoStatus}" FontSize="11" Margin="0,5" />
            <TextBlock Text="{Binding DspStatus}" FontSize="11" Foreground="{Binding DspStatus, Converter={StaticResource StatusBrush}}" />
            <Button Content="Restore Audio" Command="{Binding RestoreCommand}" FontSize="11" Padding="8,4" Margin="0,10,0,0" />
          </StackPanel>
        </Border>
      </Grid>
    </Border>
  </Grid>
</Window>