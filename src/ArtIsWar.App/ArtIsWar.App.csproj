<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF><UseWindowsForms>true</UseWindowsForms><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <!-- WPF owns DPI awareness; WinForms supplies only the tray icon. -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
    <ApplicationManifest>app.manifest</ApplicationManifest><AssemblyName>WarTune</AssemblyName>
    <ApplicationIcon>Assets/App.ico</ApplicationIcon>
    <Product>WarTune</Product><Title>WarTune</Title><PlatformTarget>x64</PlatformTarget><Version>1.0.0</Version>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="../ArtIsWar.Core/ArtIsWar.Core.csproj"/></ItemGroup>
  <ItemGroup><Resource Include="Assets/App.ico"/></ItemGroup>
  <ItemGroup><Resource Include="Assets/WarTune.png"/></ItemGroup>
  <ItemGroup><Content Include="../../artifacts/ArtIsWar.Dsp.dll" Link="ArtIsWar.Dsp.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"/></ItemGroup>
</Project>
